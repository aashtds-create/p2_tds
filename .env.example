# Required: Your secret from the Google Form
SECRET=your_secret_here

# Required: Your email from the Google Form
EMAIL=your_email@ds.study.iitm.ac.in

# Required: Gemini API key (primary LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API key (fallback if Gemini is not set)
OPENAI_API_KEY=your_openai_api_key

# Optional: Port for the server (default: 8000)
PORT=8000
